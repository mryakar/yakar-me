---
import '../styles/global.css';
import Head, { type Article } from '../components/Head.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import LangHint from '../components/LangHint.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { ui } from '../i18n/ui';
import { defaultLang, localize, locales, other, splitPath, type Lang } from '../lib/i18n';
import { paths, site } from '../site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  article?: Article;
  counterpart?: boolean;
  notFound?: boolean;
  runningHead?: string;
}
const { lang, title, description = ui[lang].description, article, counterpart = true, notFound = false, runningHead } = Astro.props;
const { path } = splitPath(Astro.url.pathname);
const alternates = counterpart && !notFound ? locales.map((l) => ({ lang: l, href: localize(path, l) })) : [];
const printHead = runningHead && {
  'data-print-head': `${site.name} · ${site.domain}`,
  'data-print-title': runningHead,
  'data-print-url': `${site.domain}${Astro.url.pathname}`,
};
const switchTo = notFound ? localize(paths.home, other(lang)) : counterpart ? localize(path, other(lang)) : undefined;
---
<!doctype html>
<html lang={lang} {...printHead}>
  <head>
    <Head lang={lang} title={title} description={description} article={article} alternates={alternates} notFound={notFound} />
    <slot name="head" />
  </head>
  <body class="bg-bg text-text">
    <a class="skip-link print:hidden" href="#main">{ui[lang].skip}</a>
    <div class="min-h-dvh desk:flex">
      <Sidebar lang={lang} switchTo={switchTo} />
      <MobileMenu lang={lang} switchTo={switchTo} />
      <main id="main" class="min-w-0 flex-1">
        {lang === defaultLang && switchTo && !notFound && <LangHint href={switchTo} target={other(lang)} />}
        <slot />
      </main>
    </div>
    <SearchPalette lang={lang} />
    <script>
      import '../scripts/theme-toggle.ts';
      import '../scripts/palette.ts';
    </script>
  </body>
</html>
