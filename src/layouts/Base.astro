---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site, nav, links } from '../site';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import uiFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Yazı sayfalarında 'article' ve yayın tarihi (Open Graph). */
  article?: { published: Date; section: string };
}

const { title, description = site.description, article } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.domain}`} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#08090a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline src="/theme.js"></script>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-bg text-text">
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="min-h-dvh desk:flex">
      <!-- Masaüstü: solda sabit menü -->
      <aside class="hidden w-62 flex-none border-r border-line bg-side desk:block">
        <div class="sticky top-0 flex h-dvh flex-col gap-14 px-8 py-12">
        <div class="flex flex-col gap-1.5">
          <a href="/" class="font-display text-d4">{site.name}</a>
          <span class="label text-faint">{site.domain}</span>
        </div>
        <nav aria-label="Main" class="flex flex-col gap-0.5">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="group flex min-h-10 items-center gap-3 text-[15px] text-muted transition-colors duration-200 hover:text-text aria-[current=page]:text-text"
            >
              <span class="size-[5px] rounded-full transition-colors duration-200 group-hover:bg-line-strong group-aria-[current=page]:bg-accent" />
              <span class="grow">{item.label}</span>
              {item.tag && <span class="label text-faint">{item.tag}</span>}
            </a>
          ))}
        </nav>
        <div class="mt-auto flex flex-col gap-7">
          <ul class="flex flex-col gap-3">
            {links.map((link) => (
              <li><a href={link.href} rel="me" class="text-[13px] text-muted transition-colors duration-200 hover:text-accent">{link.label}</a></li>
            ))}
          </ul>
          <ThemeToggle />
        </div>
        </div>
      </aside>

      <!-- Telefon: üst çubuk + tam ekran menü (popover, JS gerekmez) -->
      <header class="flex items-center justify-between px-6 py-5 desk:hidden">
        <a href="/" class="font-display text-d4">{site.name}</a>
        <button
          type="button"
          popovertarget="menu"
          aria-label="Open menu"
          class="inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-text"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16"></path></svg>
        </button>
      </header>

      <div id="menu" popover class="menu desk:hidden">
        <div class="flex items-center justify-between">
          <span class="font-display text-d4">{site.name}</span>
          <button
            type="button"
            popovertarget="menu"
            popovertargetaction="hide"
            aria-label="Close menu"
            class="inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-text"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
        <nav aria-label="Main" class="mt-14 flex flex-col">
          {nav.map((item, i) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="flex min-h-16 items-baseline gap-4 border-b border-line py-2 aria-[current=page]:text-accent"
            >
              <span class="label text-faint">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display text-d3">{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="mt-auto flex flex-col gap-6 pt-10">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
            {links.map((link) => (
              <li><a href={link.href} rel="me">{link.label.includes('@') ? 'Email' : link.label}</a></li>
            ))}
          </ul>
          <ThemeToggle />
        </div>
      </div>

      <main id="main" class="min-w-0 flex-1">
        <slot />
      </main>
    </div>

    <script>
      import '../scripts/theme-toggle.ts';
    </script>
  </body>
</html>
