---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'kbd'>;
const { class: className, ...rest } = Astro.props;
---

<kbd
  aria-hidden="true"
  class:list={[
    'inline-flex h-5.5 min-w-5.5 flex-none items-center whitespace-nowrap justify-center rounded-[5px] border border-line-strong bg-cell px-1.5 font-mono text-[12px] text-muted',
    className,
  ]}
  {...rest}
>
  <slot />
</kbd>
