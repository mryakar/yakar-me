---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { site, nav, links } from '../site';
import { ui } from '../i18n/ui';
import { isCurrent } from '../lib/nav';
import { localize, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  switchTo?: string;
}
const { lang, switchTo } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const home = localize('/', lang);
---
<aside class="hidden w-62 flex-none border-r border-line bg-side desk:block">
  <div class="sticky top-0 flex h-dvh flex-col gap-14 px-8 py-12">
    <div class="flex flex-col gap-1.5">
      <a href={home} class="font-display text-d4">{site.name}</a>
      <span class="label text-faint">{site.domain}</span>
    </div>
    <nav aria-label={t.mainNav} class="flex flex-col gap-0.5">
      {nav.map((item) => (
        <a
          href={localize(item.href, lang)}
          aria-current={isCurrent(path, localize(item.href, lang), home) ? 'page' : undefined}
          class="group flex min-h-10 items-center gap-3 text-base text-muted transition-colors duration-200 hover:text-text aria-[current=page]:text-text"
        >
          <span class="size-[5px] rounded-full transition-colors duration-200 group-hover:bg-line-strong group-aria-[current=page]:bg-accent" />
          <span>{t.nav[item.key]}</span>
        </a>
      ))}
    </nav>
    <div class="mt-auto flex flex-col gap-7">
      <ul class="flex flex-col gap-3">
        {links.map((link) => (
          <li><a href={link.href} rel="me" class="text-sm text-muted transition-colors duration-200 hover:text-accent">{link.label}</a></li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-2.5">
        <ThemeToggle lang={lang} />
        {switchTo && <LanguageSwitch lang={lang} href={switchTo} />}
      </div>
    </div>
  </div>
</aside>
