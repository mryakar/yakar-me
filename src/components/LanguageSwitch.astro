---
import { ui } from '../i18n/ui';
import { other, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  href: string;
}
const { lang, href } = Astro.props;
const target = other(lang);
---
<a
  href={href}
  hreflang={target}
  lang={target}
  class="inline-flex h-11 items-center gap-2.5 self-start rounded-full border border-line-strong px-4 text-sm text-muted transition-colors duration-200 hover:border-muted hover:text-text"
>
  <span class="label text-faint" aria-hidden="true">{target}</span>
  <span>{ui[target].languageName}</span>
</a>
