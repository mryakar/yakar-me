---
import { MARK, MARK_VIEWBOX } from '../lib/mark-drawing';
import { inkBox, strokes, viewBox } from '../lib/mark';

interface Props {
  class: string;
  fine?: boolean;
  tight?: boolean;
}
const { class: className, fine = false, tight = false } = Astro.props;
const marks = strokes(MARK, fine);
---

<svg
  class={className}
  viewBox={tight ? viewBox(inkBox(marks)) : MARK_VIEWBOX}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {marks.map((s) => (
    <path d={s.d} stroke-width={s.width} />
  ))}
</svg>
