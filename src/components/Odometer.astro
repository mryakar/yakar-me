---
import { odometer, readout } from '../lib/measure';

type Props = { value: number; cells: number; size?: 'big' | 'small' } | { shown: string; size: 'mini' };
const { size } = Astro.props;
const chars = 'shown' in Astro.props ? readout(Astro.props.shown) : odometer(Astro.props.value, Astro.props.cells);
const digitClass = ['d-0', 'd-1', 'd-2', 'd-3', 'd-4', 'd-5', 'd-6', 'd-7', 'd-8', 'd-9'];
const sizeClass = { big: 'odo-big', small: 'odo-small', mini: 'odo-mini' };
---
<span class:list={['odo-cells', size && sizeClass[size]]} aria-hidden="true">
  {chars.map((c) =>
    'digit' in c ? (
      <span class:list={['odo-cell', digitClass[c.digit]]} data-lead={'lead' in c && c.lead ? '' : undefined}></span>
    ) : (
      <span class="odo-sep">{c.separator}</span>
    ),
  )}
</span>
