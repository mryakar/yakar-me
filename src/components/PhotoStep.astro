---
interface Props {
  direction: 'prev' | 'next';
  label: string;
  class?: string;
}
const { direction, label, class: className } = Astro.props;
const path = direction === 'prev' ? 'M19 12H5M11 6l-6 6 6 6' : 'M5 12h14M13 6l6 6-6 6';
---
<button
  type="button"
  data-prev={direction === 'prev' ? '' : undefined}
  data-next={direction === 'next' ? '' : undefined}
  aria-label={label}
  class:list={['size-14 flex-none items-center justify-center rounded-full text-muted transition-colors duration-200 hover:text-accent', className]}
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}></path></svg>
</button>
