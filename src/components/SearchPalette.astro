---
import Kbd from './Kbd.astro';
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { localize, type Lang } from '../lib/i18n';
import { sectionLinks } from '../lib/nav';
import { QUERY_MAX } from '../lib/search';
import { paths } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].search;
---

<dialog
  data-palette
  aria-label={t.title}
  data-index={localize(paths.searchIndex, lang)}
  data-page={localize(paths.search, lang)}
  data-one={t.results.one}
  data-other={t.results.other}
  data-none={t.none}
  data-loading={t.loading}
  data-failed={t.failed}
  class="mx-auto mt-33 w-[min(40rem,calc(100vw-2rem))] max-w-none max-h-[calc(100dvh-10rem)] flex-col overflow-hidden rounded-xl border border-line-strong bg-card p-0 text-text shadow-[0_24px_64px_var(--yk-shadow)] open:flex backdrop:bg-[color-mix(in_srgb,var(--yk-dim)_78%,transparent)]"
>
  <div class="flex h-15 flex-none items-center gap-3 border-b border-line pr-4 pl-5">
    <Icon name="search" size={18} class="flex-none text-muted" />
    <input
      type="search"
      role="combobox"
      aria-label={t.label}
      aria-expanded="false"
      aria-controls="palette-results"
      aria-autocomplete="list"
      placeholder={t.label}
      maxlength={QUERY_MAX}
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
      class="h-10 min-w-0 flex-1 bg-transparent font-ui text-lg text-text outline-none placeholder:text-faint [&::-webkit-search-cancel-button]:hidden"
    />
    <Kbd>esc</Kbd>
  </div>
  <div
    id="palette-results"
    role="listbox"
    aria-label={t.title}
    hidden
    class="min-h-0 flex-1 overflow-y-auto px-2 pt-3 pb-2"
  >
    {sectionLinks(lang).map((g) => (
      <div
        role="group"
        data-palette-group={g.key}
        aria-labelledby={`palette-${g.key}`}
        hidden
        class="flex flex-col pb-2"
      >
        <div id={`palette-${g.key}`} class="label flex gap-2.5 px-3 pt-1 pb-2 text-faint">
          {g.label}
          <span data-palette-count class="text-muted"></span>
        </div>
        <div data-palette-list class="flex flex-col"></div>
      </div>
    ))}
  </div>
  <p data-palette-none hidden class="label px-6 py-7 text-faint">
    {t.none}
  </p>
  <div class="flex h-11 flex-none items-center justify-between gap-4 border-t border-line bg-side pr-4 pl-5">
    <p data-palette-status role="status" class="label text-faint"></p>
    <div class="ml-auto flex items-center gap-1.5">
      <a
        data-palette-all
        href={localize(paths.search, lang)}
        hidden
        class="mr-3.5 text-[13px] text-muted transition-colors duration-200 hover:text-text"
      >
        {t.all} →
      </a>
      <Kbd>↑</Kbd>
      <Kbd>↓</Kbd>
      <Kbd>↵</Kbd>
    </div>
  </div>
  <template data-palette-option>
    <a
      role="option"
      aria-selected="false"
      class="group flex h-11 flex-none items-center gap-4 rounded-md px-3 aria-selected:bg-sleeve"
    >
      <span data-palette-title class="min-w-0 flex-1 truncate text-[15px]"></span>
      <span data-palette-date class="label flex-none text-faint"></span>
      <Kbd class="invisible group-aria-selected:visible">↵</Kbd>
    </a>
  </template>
</dialog>
