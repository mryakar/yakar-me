---
import { site, paths } from '../site';
import { defaultLang, localize, ogLocale, type Lang, type LangLink } from '../lib/i18n';
import { absoluteUrl, ogImagePath } from '../lib/format';
import { OG_SIZE } from '../lib/og';
import { PAGE_BACKGROUND } from '../lib/theme';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import uiFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

export interface Article {
  published: Date;
  section: string;
  image: string;
}

interface Props {
  lang: Lang;
  title: string;
  description: string;
  article?: Article;
  alternates: LangLink[];
  notFound: boolean;
}
const { lang, title, description, article, alternates, notFound } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(article?.image ?? ogImagePath(lang));
const xDefault = alternates.find((a) => a.lang === defaultLang);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<title>{title}</title>
<meta name="description" content={description} />
{!notFound && <link rel="canonical" href={canonical} />}
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={absoluteUrl(a.href)} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.href)} />}
<link rel="alternate" type="application/rss+xml" title={site.name} href={localize(paths.feed, lang)} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={ogLocale[lang]} />
{alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!notFound && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(OG_SIZE.width)} />
<meta property="og:image:height" content={String(OG_SIZE.height)} />
<meta property="og:image:alt" content={article ? title : `${site.name} — ${site.domain}`} />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article && <meta property="article:section" content={article.section} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content={PAGE_BACKGROUND.dark} media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content={PAGE_BACKGROUND.light} media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script is:inline src="/theme.js"></script>
<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
