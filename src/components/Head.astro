---
import { site } from '../site';
import { defaultLang, localize, ogLocale, other, type Lang } from '../lib/i18n';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import uiFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  article?: { published: Date; section: string };
  alternates: { lang: Lang; href: string }[];
  notFound: boolean;
}
const { lang, title, description, article, alternates, notFound } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(lang === defaultLang ? '/og.png' : `/og-${lang}.png`, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).toString();
const xDefault = alternates.find((a) => a.lang === defaultLang);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<title>{title}</title>
<meta name="description" content={description} />
{!notFound && <link rel="canonical" href={canonical} />}
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={absolute(a.href)} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault.href)} />}
<link rel="alternate" type="application/rss+xml" title={site.name} href={localize('/rss.xml', lang)} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={ogLocale[lang]} />
{alternates.length > 0 && <meta property="og:locale:alternate" content={ogLocale[other(lang)]} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!notFound && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.domain}`} />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article && <meta property="article:section" content={article.section} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#08090a" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script is:inline src="/theme.js"></script>
<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
