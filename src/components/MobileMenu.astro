---
// Telefon: üst çubuk + tam ekran menü (HTML popover; JS gerekmez, Esc tarayıcıdan).
import ThemeToggle from './ThemeToggle.astro';
import { site, nav, links } from '../site';
import { isCurrent } from '../lib/nav';

const path = Astro.url.pathname;
const roundButton = 'inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-text';
---

<header class="flex items-center justify-between px-6 py-5 desk:hidden">
  <a href="/" class="font-display text-d4">{site.name}</a>
  <button type="button" popovertarget="menu" aria-label="Open menu" class={roundButton}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16"></path></svg>
  </button>
</header>

<div id="menu" popover class="menu desk:hidden">
  <div class="flex items-center justify-between">
    <span class="font-display text-d4">{site.name}</span>
    <button type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu" class={roundButton}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>
  <nav aria-label="Main" class="mt-14 flex flex-col">
    {nav.map((item, i) => (
      <a
        href={item.href}
        aria-current={isCurrent(path, item.href) ? 'page' : undefined}
        class="flex min-h-16 items-baseline gap-4 border-b border-line py-2 aria-[current=page]:text-accent"
      >
        <span class="label text-faint">{String(i + 1).padStart(2, '0')}</span>
        <span class="font-display text-d3">{item.label}</span>
      </a>
    ))}
  </nav>
  <div class="mt-auto flex flex-col gap-6 pt-10">
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
      {links.map((link) => (
        <li><a href={link.href} rel="me">{link.short}</a></li>
      ))}
    </ul>
    <ThemeToggle />
  </div>
</div>
