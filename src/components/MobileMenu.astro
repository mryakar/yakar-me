---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { site, links } from '../site';
import { ui } from '../i18n/ui';
import { navLinks } from '../lib/nav';
import { localize, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  switchTo?: string;
}
const { lang, switchTo } = Astro.props;
const t = ui[lang];
const home = localize('/', lang);
const items = navLinks(Astro.url.pathname, lang);
const roundButton = 'inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-text';
---
<header class="flex items-center justify-between px-6 py-5 desk:hidden">
  <a href={home} class="font-display text-d4">{site.name}</a>
  <button type="button" popovertarget="menu" aria-label={t.openMenu} class={roundButton}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16"></path></svg>
  </button>
</header>

<div id="menu" popover class="menu desk:hidden">
  <div class="flex items-center justify-between">
    <span class="font-display text-d4">{site.name}</span>
    <button type="button" popovertarget="menu" popovertargetaction="hide" aria-label={t.closeMenu} class={roundButton}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>
  <nav aria-label={t.mainNav} class="mt-14 flex flex-col">
    {items.map((item, i) => (
      <a
        href={item.href}
        aria-current={item.current ? 'page' : undefined}
        class="flex min-h-16 items-baseline gap-4 border-b border-line py-2 aria-[current=page]:text-accent"
      >
        <span class="label text-faint">{String(i + 1).padStart(2, '0')}</span>
        <span class="font-display text-d3">{item.label}</span>
      </a>
    ))}
  </nav>
  <div class="mt-auto flex flex-col gap-6 pt-10">
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
      {links.map((link) => (
        <li><a href={link.href} rel="me">{link.short ?? t.email}</a></li>
      ))}
    </ul>
    <div class="flex flex-wrap gap-2.5">
      <ThemeToggle lang={lang} />
      {switchTo && <LanguageSwitch lang={lang} href={switchTo} />}
    </div>
  </div>
</div>
