---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
import { localize, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].notFound;
---
<Base lang={lang} title={t.title} notFound>
  <section class="flex flex-col gap-8 px-6 pt-9 pb-16 desk:px-24 desk:pt-26">
    <span class="label text-accent">404</span>
    <h1 class="font-display text-d2 desk:text-d1">{t.heading}</h1>
    <p class="text-lede text-muted"><a href={localize('/', lang)} class="text-accent">{t.back}</a></p>
  </section>
</Base>
