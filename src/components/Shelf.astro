---
import { topics, type Article } from '../lib/writing';
import { articlePath, formatDate, formatMonth } from '../lib/format';
import ArrowRight from './ArrowRight.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../lib/i18n';

interface Props {
  articles: Article[];
  lang: Lang;
}
const { articles, lang } = Astro.props;
const t = ui[lang];
const byTopic = topics
  .map((topic) => ({ topic, items: articles.filter((a) => a.topic === topic) }))
  .filter((s) => s.items.length > 0);

export const MAX_SLEEVES = 12;
for (const { topic, items } of byTopic) {
  if (items.length > MAX_SLEEVES) {
    throw new Error(`Shelf "${topic}" has ${items.length} records; stacking is defined for ${MAX_SLEEVES}. Extend .sleeve:nth-child rules in global.css.`);
  }
}
---
<div class="flex flex-col gap-16">
  {byTopic.map(({ topic, items }) => (
    <div class="flex flex-col" data-previews>
      <div class="shelf">
        {items.map((a, i) => (
          <a href={articlePath(a.id, lang)} class="sleeve" data-preview-for={a.id} data-active={i === 0 ? '' : undefined}>
            <span class="label text-accent">{formatMonth(a.pubDate, lang)}</span>
            <span class="line-clamp-4 font-body text-base leading-[1.15] hyphens-auto text-text desk:text-[1.25rem]">{a.short ?? a.title}</span>
            <span class="label text-muted">{t.writing.topics[a.topic]}</span>
          </a>
        ))}
      </div>
      <div class="h-px bg-accent/40" />
      <div class="grid gap-5 pt-4 desk:grid-cols-[10rem_minmax(0,1fr)] desk:gap-10">
        <span class="label pt-1 text-faint">{t.writing.topics[topic]} · {items.length}</span>
        {items.map((a, i) => (
          <article class="flex max-w-180 flex-col gap-2" data-preview={a.id} hidden={i !== 0}>
            <h3 class="font-body text-xl leading-snug text-text">
              <a href={articlePath(a.id, lang)} class="transition-colors duration-200 hover:text-accent">{a.title}</a>
            </h3>
            <p class="font-body text-base leading-relaxed text-muted">{a.description}</p>
            <div class="flex items-center gap-5 pt-1">
              <span class="label text-faint">{formatDate(a.pubDate, 'short', lang)}</span>
              <a href={articlePath(a.id, lang)} class="group inline-flex items-center gap-2 text-sm text-accent">
                {t.home.read}
                <ArrowRight size={13} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}
</div>

<script>
  import '../scripts/preview.ts';
</script>
