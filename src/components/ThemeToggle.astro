---
import { ui } from '../i18n/ui';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const t = ui[Astro.props.lang].theme;
---
<button
  type="button"
  data-theme-toggle
  data-to-dark={t.toDark}
  data-to-light={t.toLight}
  aria-label={t.toggle}
  class="inline-flex h-11 items-center gap-2.5 self-start rounded-full border border-line-strong px-4 text-sm text-muted transition-colors duration-200 hover:border-muted hover:text-text"
>
  <svg class="light:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
  <svg class="hidden light:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  <span class="light:hidden">{t.dark}</span>
  <span class="hidden light:inline">{t.light}</span>
</button>
