---
import PhotoPicture from './PhotoPicture.astro';
import { aperture, coordinates, focalLength, recipeRows, shutter, takenYear, PHOTOGRAPHER } from '../lib/photo';
import { photoSlug, type Photo } from '../lib/photos';

interface Props {
  photo: Photo;
  index: number;
  total: number;
  series: string;
}
const { photo, index, total, series } = Astro.props;
const p = photo.data;
const numbers = [
  [aperture(p.aperture), 'Aperture'],
  [shutter(p.shutter), 'Shutter'],
  [String(p.iso), 'ISO'],
  [focalLength(p), 'Focal length'],
];
const control = 'size-11 flex-none items-center justify-center rounded-full text-muted transition-colors duration-200 hover:text-accent';
---
<article data-photo={photoSlug(photo)} hidden class="lightbox-panel" aria-label={`${series}, photo ${index + 1} of ${total}`}>
  <div class="flex items-center justify-between gap-4 text-[13px] text-muted">
    <span>{series} · {index + 1} / {total}</span>
    <span class="flex items-center gap-5">
      <span class="label hidden text-faint desk:inline">Esc</span>
      <button type="button" data-close aria-label="Close" class="inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-text">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13"></path></svg>
      </button>
    </span>
  </div>

  <div class="lightbox-body">
    <div class="lightbox-stage">
      <button type="button" data-prev aria-label="Previous photo" class:list={[control, 'hidden desk:inline-flex']}>←</button>
      <PhotoPicture photo={photo} sizes="(min-width: 64rem) 62vw, 100vw" class="lightbox-image" />
      <button type="button" data-next aria-label="Next photo" class:list={[control, 'hidden desk:inline-flex']}>→</button>
    </div>

    <aside class="flex flex-col gap-7 desk:justify-center desk:border-l desk:border-line desk:pl-10">
      <div class="flex flex-col gap-1.5">
        <span class="label text-faint">{p.kind === 'fujifilm' ? `${p.make} ${p.model}` : p.make}</span>
        <span class="text-[15px] text-text">{p.kind === 'fujifilm' ? `${p.lens} · ${p.recipe!.filmSimulation}` : p.model}</span>
      </div>

      <dl class="grid grid-cols-4 gap-x-2 gap-y-5 desk:grid-cols-2 desk:gap-x-4">
        {numbers.map(([value, label]) => (
          <div class="flex flex-col-reverse gap-1">
            <dt class="label text-faint">{label === 'Focal length' ? <>Focal<span class="hidden desk:inline"> length</span></> : label}</dt>
            <dd class="font-display text-d4 leading-none text-text">{value}</dd>
          </div>
        ))}
      </dl>

      {p.recipe && recipeRows(p.recipe).length > 0 && (
        <div class="flex flex-col gap-2">
          <span class="label text-accent">Recipe</span>
          <dl class="flex flex-col">
            {recipeRows(p.recipe).map(([label, value]) => (
              <div class="flex justify-between gap-3 border-b border-line py-1.5 text-xs">
                <dt class="text-faint">{label}</dt>
                <dd class="text-right font-mono text-text">{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      <span class="font-mono text-[13px] text-accent">{coordinates(p.location)}</span>
      <span class="text-xs text-faint">© {takenYear(p.taken)} {PHOTOGRAPHER}</span>
    </aside>
  </div>

  <div class="flex justify-between desk:hidden">
    <button type="button" data-prev aria-label="Previous photo" class:list={[control, 'inline-flex']}>←</button>
    <button type="button" data-next aria-label="Next photo" class:list={[control, 'inline-flex']}>→</button>
  </div>
</article>
