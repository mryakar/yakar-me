---
import { categoryTint, spineHeight, spineThickness, SPINE_HEIGHTS, SPINE_THICKNESSES } from '../lib/book';
import { formatMonth } from '../lib/format';
import { localize, type Lang } from '../lib/i18n';
import type { FinishedBook, ReadingBook } from '../lib/books';
import { ui } from '../i18n/ui';

interface Props {
  reading: ReadingBook[];
  finished: FinishedBook[];
  lang: Lang;
}
const { reading, finished, lang } = Astro.props;
const t = ui[lang];
const page = localize('/reading/', lang);
const widths = ['w-4.5 desk:w-5.5', 'w-5 desk:w-6.25', 'w-5.5 desk:w-7', 'w-6 desk:w-7.75', 'w-6.5 desk:w-8.5', 'w-7 desk:w-9.25', 'w-7.5 desk:w-10', 'w-8 desk:w-10.75', 'w-8.5 desk:w-11.5', 'w-9 desk:w-12.25', 'w-9.5 desk:w-13', 'w-10 desk:w-13.75', 'w-10.5 desk:w-14.5', 'w-11 desk:w-15.25', 'w-11.5 desk:w-16', 'w-12 desk:w-16.75'];
const heights = ['h-39 desk:h-49', 'h-41 desk:h-51', 'h-43 desk:h-53', 'h-45 desk:h-55', 'h-47 desk:h-57'];
if (widths.length !== SPINE_THICKNESSES || heights.length !== SPINE_HEIGHTS) throw new Error('BookShelf: spine class lists do not match the spine scale in src/lib/book.ts');
const spines = [
  ...reading.map((book) => ({ book, label: t.home.now, now: true })),
  ...finished.map((book) => ({ book, label: formatMonth(book.finished, lang), now: false })),
];
---
<div class="flex flex-col">
  <div class="book-row">
    {spines.map(({ book, label, now }) => (
      <a href={`${page}#${book.id}`} class:list={['book-spine', categoryTint[book.category], widths[spineThickness(book.pages)], heights[spineHeight(book.id)]]} data-now={now ? '' : undefined}>
        <span class="book-spine-name truncate font-body text-xs leading-[1.1] tab:text-sm">{book.title}</span>
        <span class="book-spine-label label">{label}</span>
      </a>
    ))}
  </div>
  {reading.length > 0 && (
    <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1.5 pt-4">
      <span class="label text-accent">{t.reading.now}</span>
      <span class="font-body text-[17px] text-text tab:text-[19px]">
        {reading.map((book, i) => (
          <>{i > 0 && ' · '}<em>{book.title}</em></>
        ))}
      </span>
    </p>
  )}
</div>
