---
import Views from './Views.astro';
import { ui } from '../i18n/ui';
import { localize, type Lang } from '../lib/i18n';
import { mapPath } from '../lib/photo';

interface Props {
  lang: Lang;
  current: 'series' | 'map';
  series: number;
  places: number;
}
const { lang, current, series, places } = Astro.props;
const t = ui[lang].photos;
const views = [
  { href: localize('/photos/', lang), label: t.seriesView, count: series, current: current === 'series' },
  { href: mapPath(lang), label: t.mapView, count: places, current: current === 'map' },
];
---
<Views title={ui[lang].nav.photos} label={t.views} views={views} />
