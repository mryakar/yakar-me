---
interface Props {
  title: string;
  label: string;
  views: { href: string; label: string; count: number; current: boolean }[];
}
const { title, label, views } = Astro.props;
---
<header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-line pb-2 tab:pb-5">
  <h1 class="font-display text-d2 desk:text-d1">{title}</h1>
  <nav aria-label={label} class="flex items-center gap-4.5 tab:gap-7">
    {views.map((v) => (
      <a
        href={v.href}
        aria-current={v.current ? 'page' : undefined}
        class:list={['label flex min-h-11 items-center gap-2.5 transition-colors duration-200 hover:text-accent', v.current ? 'text-text' : 'text-muted']}
      >
        {v.current && <span class="block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>}
        {v.label} <span class="text-faint">{v.count}</span>
      </a>
    ))}
  </nav>
  <slot />
</header>
