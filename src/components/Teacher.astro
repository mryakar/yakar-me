---
import { Picture } from 'astro:assets';
import Mark from './Mark.astro';
import photo from '../assets/cihan-gulmez.jpg';
import { ui } from '../i18n/ui';
import type { Lang } from '../lib/i18n';
import { site, teacher } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].playing.teacher;
const role = 'font-mono text-[10px] tracking-[0.12em] uppercase';
---

<section aria-labelledby="teacher" class="@container flex flex-col gap-6 border-y border-line py-7">
  <h2 id="teacher" class="label text-accent">
    {t.heading}
  </h2>

  <div class="flex flex-col gap-[22px] @3xl:flex-row @3xl:gap-10">
    <Picture
      src={photo}
      alt={t.alt(teacher.name)}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[440, 520, 660, 780]}
      sizes="260px"
      class="block h-auto w-[260px] max-w-full flex-none border border-line @3xl:w-[220px]"
    />

    <div class="flex min-w-0 flex-auto flex-col justify-between gap-[18px] @3xl:gap-6">
      <div class="flex flex-col gap-3.5 @3xl:pt-2">
        <div class="flex flex-col gap-1.5">
          <p class:list={[role, 'text-accent']}>{t.master}</p>
          <p class="font-display text-[40px] leading-[1.02] tracking-[-0.01em] @3xl:text-[56px]">{teacher.name}</p>
          <p class="font-body text-[17px] text-muted">{t.role}</p>
        </div>
        <ul aria-label={t.links(teacher.name)} class="label flex flex-wrap gap-x-[22px]">
          {teacher.links.map((l) => (
            <li>
              <a
                href={l.href}
                rel="noopener noreferrer"
                lang="en"
                class="flex min-h-11 items-center text-muted hover:text-accent"
              >
                {l.label}&nbsp;<span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col items-start gap-2.5 @3xl:flex-row @3xl:items-center @3xl:gap-6">
        <p class="flex items-center gap-3.5 pl-6 @3xl:min-w-[120px] @3xl:flex-auto @3xl:gap-2.5 @3xl:pl-0">
          <span aria-hidden="true" class="flex flex-col items-center @3xl:flex-1">
            <span class="h-9 w-px bg-line-strong @3xl:h-px @3xl:w-full"></span>
            <svg
              class="-mt-1 text-faint @3xl:hidden"
              width="8"
              height="8"
              viewBox="0 0 8 8"
              fill="none"
              stroke="currentColor"
            >
              <path d="M1 1 4 6 7 1"></path>
            </svg>
          </span>
          <span class:list={[role, 'whitespace-nowrap text-faint']}>{t.since}</span>
          <span aria-hidden="true" class="hidden flex-1 items-center text-faint @3xl:flex">
            <span class="h-px flex-1 bg-line-strong"></span>
            <svg class="-ml-0.5" width="8" height="8" viewBox="0 0 8 8" fill="none" stroke="currentColor">
              <path d="M1 1 6 4 1 7"></path>
            </svg>
          </span>
        </p>
        <div class="flex flex-none items-center gap-4">
          <span class="flex size-14 flex-none items-center justify-center rounded-full border border-line-strong text-accent">
            <Mark class="h-7 w-[26px]" />
          </span>
          <div class="flex min-w-0 flex-col gap-1">
            <p class:list={[role, 'text-faint']}>{t.apprentice}</p>
            <p class="font-display text-d4 leading-[1.05] text-muted">{site.name}</p>
            <p class="font-body text-[16px] text-faint">{t.instrument}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p class="max-w-[620px] font-body text-[17px] leading-[1.55] text-muted">{t.line}</p>
</section>
