---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { paths } from '../site';
import { localize, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  class: string;
  palette?: boolean;
}
const { lang, class: className, palette = false } = Astro.props;
const href = localize(paths.search, lang);
const labelled = Astro.slots.has('default');
---

<a
  href={href}
  aria-label={labelled ? undefined : ui[lang].search.title}
  aria-current={Astro.url.pathname === href ? 'page' : undefined}
  class={className}
  data-palette-open={palette || undefined}
>
  <Icon name="search" size={18} />
  <slot />
</a>
