---
import { ui } from '../i18n/ui';
import { paths } from '../site';
import { localize, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  class: string;
  palette?: boolean;
}
const { lang, class: className, palette = false } = Astro.props;
const href = localize(paths.search, lang);
const labelled = Astro.slots.has('default');
---
<a href={href} aria-label={labelled ? undefined : ui[lang].search.title} aria-current={Astro.url.pathname === href ? 'page' : undefined} class={className} data-palette-open={palette || undefined}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L20 20"></path></svg>
  <slot />
</a>
