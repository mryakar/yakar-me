---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import { articles, formatDate } from '../../lib/writing';

const all = await articles();
---

<Base title="Writing — yakar.me" description="Long-form writing on Java, databases, and the mechanisms underneath.">
  <div class="flex flex-col gap-24 px-6 pt-9 pb-24 desk:px-24 desk:pt-26">
    <header class="flex items-baseline justify-between border-b border-line pb-5">
      <h1 class="font-display text-d2 desk:text-d1">Writing</h1>
      <span class="label text-faint">{all.length} published</span>
    </header>

    <Shelf articles={all} />

    <section class="flex flex-col gap-6" aria-labelledby="all">
      <h2 id="all" class="label text-faint">All writing</h2>
      <ol class="flex flex-col">
        {all.map((a) => (
          <li class="border-t border-line">
            <a href={`/writing/${a.id}/`} class="group grid gap-1 py-5 desk:grid-cols-[9rem_minmax(0,1fr)_7rem] desk:items-baseline desk:gap-8">
              <time class="label text-faint" datetime={a.data.pubDate.toISOString().slice(0, 10)}>{formatDate(a.data.pubDate, 'short')}</time>
              <span class="font-body text-xl text-text transition-colors duration-200 group-hover:text-accent">{a.data.title}</span>
              <span class="label text-muted desk:text-right">{a.data.topic}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>
