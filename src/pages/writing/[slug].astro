---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { articles, formatDate, readingMinutes, type Article } from '../../lib/writing';

export async function getStaticPaths() {
  return (await articles()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Article };
const { title, description, pubDate, topic, mediumUrl } = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${title} — yakar.me`} description={description}>
  <article class="px-6 pt-9 pb-24 desk:px-24 desk:pt-24">
    <header class="flex max-w-240 flex-col gap-7">
      <span class="label text-accent">{topic}</span>
      <h1 class="font-display text-d2 desk:text-d1">{title}</h1>
      <p class="max-w-180 font-body text-2xl leading-snug text-muted italic">{description}</p>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-line pt-5 text-sm text-muted">
        <time datetime={pubDate.toISOString().slice(0, 10)}>{formatDate(pubDate)}</time>
        <span>{readingMinutes(entry.body)} min read</span>
        <a href={mediumUrl} class="transition-colors duration-200 hover:text-accent">Also on Medium ↗</a>
      </div>
    </header>

    <div class="mt-16 desk:grid desk:grid-cols-[minmax(0,42.5rem)_15rem] desk:items-start desk:gap-22">
      <div class="prose">
        <Content />
      </div>
      {toc.length > 0 && (
        <nav aria-label="Contents" class="sticky top-12 hidden flex-col gap-1 desk:flex">
          <span class="label pb-2.5 text-faint">Contents</span>
          {toc.map((h) => (
            <a href={`#${h.slug}`} class="group flex items-baseline gap-3 py-1.5 text-[13px] leading-snug text-muted transition-colors duration-200 hover:text-text">
              <span class="h-px w-3 flex-none -translate-y-1 bg-line-strong transition-all duration-200 group-hover:w-5 group-hover:bg-accent" />
              <span>{h.text}</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  </article>
</Base>
