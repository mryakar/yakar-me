---
import Base from '../../../layouts/Base.astro';
import Shelf from '../../../components/Shelf.astro';
import { ui } from '../../../i18n/ui';
import { langPaths, type Lang } from '../../../lib/i18n';
import { articles } from '../../../lib/writing';
import { articlePath, formatDate, isoDate } from '../../../lib/format';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].writing;
const all = await articles(lang);
---
<Base lang={lang} title={t.title} description={t.description}>
  <div class="flex flex-col gap-24 px-6 pt-9 pb-24 desk:px-24 desk:pt-26">
    <header class="flex items-baseline justify-between border-b border-line pb-5">
      <h1 class="font-display text-d2 desk:text-d1">{ui[lang].nav.writing}</h1>
      <span class="label text-faint">{t.published(all.length)}</span>
    </header>

    <Shelf articles={all} lang={lang} />

    <section class="flex flex-col gap-6" aria-labelledby="all">
      <h2 id="all" class="label text-faint">{t.all}</h2>
      <ol class="flex flex-col">
        {all.map((a) => (
          <li class="border-t border-line">
            <a href={articlePath(a.id, lang)} class="group grid gap-1 py-5 desk:grid-cols-[9rem_minmax(0,1fr)_7rem] desk:items-baseline desk:gap-8">
              <time class="label text-faint" datetime={isoDate(a.pubDate)}>{formatDate(a.pubDate, 'short', lang)}</time>
              <span class="font-body text-xl text-text transition-colors duration-200 group-hover:text-accent">{a.title}</span>
              <span class="label text-muted desk:text-right">{t.topics[a.topic]}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>
