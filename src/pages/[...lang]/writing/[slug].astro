---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TranslatedBadge from '../../../components/TranslatedBadge.astro';
import { ui } from '../../../i18n/ui';
import { langItemPaths, type Lang } from '../../../lib/i18n';
import { articles, type Article } from '../../../lib/writing';
import { articlePath, documentTitle, formatDate, isoDate, readingMinutes } from '../../../lib/format';
import { isSummaryHeading } from '../../../lib/markdown';

export const getStaticPaths = () => langItemPaths(articles, (article) => ({ slug: article.id }));

const { lang, item: article } = Astro.props as { lang: Lang; item: Article };
const t = ui[lang].writing;
const { title, description, pubDate, topic, mediumUrl } = article;
const { Content, headings } = await render(article.entry);
type Entry = { slug: string; text: string; children: { slug: string; text: string }[] };
const toc: Entry[] = [];
for (const h of headings) {
  if (isSummaryHeading(h.text)) continue;
  if (h.depth === 2) toc.push({ slug: h.slug, text: h.text, children: [] });
  else if (h.depth === 3 && toc.length) toc[toc.length - 1].children.push({ slug: h.slug, text: h.text });
}
---
<Base lang={lang} title={documentTitle(title)} description={description} article={{ published: pubDate, section: t.topics[topic] }} counterpart={article.alternate}>
  <article class="mx-auto max-w-[86.5rem] px-6 pt-9 pb-24 desk:px-24 desk:pt-24">
    <header class="flex max-w-240 flex-col gap-7">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="label text-accent">{t.topics[topic]}</span>
        {article.original !== lang && <TranslatedBadge original={article.original} href={articlePath(article.id, article.original)} />}
      </div>
      <h1 class="font-display text-d2 desk:text-d1">{title}</h1>
      <p class="max-w-180 font-body text-2xl leading-snug text-muted italic">{description}</p>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-line pt-5 text-sm text-muted">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate, 'long', lang)}</time>
        <span>{t.minRead(readingMinutes(article.entry.body))}</span>
        <a href={mediumUrl} class="transition-colors duration-200 hover:text-accent">{t.medium}</a>
      </div>
    </header>

    <div class="mt-16 desk:grid desk:grid-cols-[minmax(0,46rem)_15rem] desk:items-start desk:gap-22 wide:grid-cols-[minmax(0,52rem)_17rem]">
      <div class="prose">
        <Content />
      </div>
      {toc.length > 0 && (
        <nav aria-label={t.contents} class="sticky top-12 hidden max-h-[calc(100dvh-6rem)] flex-col gap-1 overflow-y-auto desk:flex">
          <span class="label pb-2.5 text-faint">{t.contents}</span>
          <ul class="flex flex-col">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="group flex items-baseline gap-3 py-1.5 text-sm leading-snug text-muted transition-colors duration-200 hover:text-text">
                  <span class="h-px w-3 flex-none -translate-y-1 bg-line-strong transition-all duration-200 group-hover:w-5 group-hover:bg-accent" />
                  <span>{h.text}</span>
                </a>
                {h.children.length > 0 && (
                  <ul class="mb-1 ml-6 flex flex-col border-l border-line pl-3">
                    {h.children.map((c) => (
                      <li>
                        <a href={`#${c.slug}`} class="block py-1 text-[13px] leading-snug text-faint transition-colors duration-200 hover:text-text">{c.text}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>
</Base>
