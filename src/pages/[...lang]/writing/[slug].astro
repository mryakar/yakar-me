---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TranslatedBadge from '../../../components/TranslatedBadge.astro';
import Continue from '../../../components/Continue.astro';
import { ui } from '../../../i18n/ui';
import { langItemPaths } from '../../../lib/i18n';
import { articles } from '../../../lib/writing';
import { absoluteUrl, articlePath, documentTitle, formatDate, isoDate, readingMinutes } from '../../../lib/format';
import { blogPosting, jsonLd } from '../../../lib/structured';
import { articleCard, ogImagePathFor } from '../../../lib/og';
import { links, paths, site } from '../../../site';
import { localize } from '../../../lib/i18n';
import { neighbours, others } from '../../../lib/sequence';
import { tableOfContents } from '../../../lib/markdown';
import bodyLatin from '../../../fonts/newsreader-latin-normal.woff2?url';
import bodyLatinItalic from '../../../fonts/newsreader-latin-italic.woff2?url';
import bodyLatinExt from '../../../fonts/newsreader-latin-ext-normal.woff2?url';
import bodyLatinExtItalic from '../../../fonts/newsreader-latin-ext-italic.woff2?url';

export const getStaticPaths = () => langItemPaths(articles, (article) => ({ slug: article.id }));

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, item: article } = Astro.props;
const t = ui[lang].writing;
const { title, description, pubDate, topic, mediumUrl } = article;
const { Content, headings } = await render(article.entry);
const toc = tableOfContents(headings);
const sameTopic = (await articles(lang)).filter((a) => a.topic === topic);
const { previous, next } = neighbours(sameTopic, (a) => a.id === article.id);
const shownIds = [article, previous, next].flatMap((a) => (a ? [a.id] : []));
const more = others(sameTopic, (a) => shownIds.includes(a.id), 2);
const link = (a: (typeof sameTopic)[number]) => ({
  href: articlePath(a.id, lang),
  title: a.title,
  meta: formatDate(a.pubDate, 'long', lang),
});
const medium = links.find((l) => l.label === 'Medium')!;
const bodyFonts =
  lang === 'tr' ? [bodyLatin, bodyLatinItalic, bodyLatinExt, bodyLatinExtItalic] : [bodyLatin, bodyLatinItalic];
const url = absoluteUrl(articlePath(article.id, lang));
const ogImage = await ogImagePathFor(articleCard(article, lang));
const structured = jsonLd(
  blogPosting({
    headline: title,
    description,
    published: pubDate,
    lang,
    url,
    image: absoluteUrl(ogImage),
    author: { name: site.name, url: site.url },
    original:
      article.original === lang
        ? undefined
        : { url: absoluteUrl(articlePath(article.id, article.original)), lang: article.original },
  }),
);
---

<Base
  lang={lang}
  title={documentTitle(title)}
  description={description}
  article={{ published: pubDate, section: t.topics[topic], image: ogImage }}
  langs={article.langs}
  runningHead={title}
>
  {bodyFonts.map((href) => (
    <link rel="preload" href={href} as="font" type="font/woff2" crossorigin slot="head" />
  ))}
  <script type="application/ld+json" set:html={structured} />
  <article class="print-article mx-auto max-w-[86.5rem] px-6 pt-9 pb-24 desk:px-24 desk:pt-24">
    <header class="article-head flex max-w-240 flex-col gap-7">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="label text-accent">{t.topics[topic]}</span>
        {article.original !== lang && (
          <TranslatedBadge original={article.original} href={articlePath(article.id, article.original)} />
        )}
      </div>
      <h1 class="font-display text-d2 desk:text-d1">{title}</h1>
      <p class="max-w-180 font-body text-2xl leading-snug text-muted italic print:hidden">{description}</p>
      <p class="article-url hidden">{url}</p>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-line pt-5 text-sm text-muted">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate, 'long', lang)}</time>
        <span>{t.minRead(readingMinutes(article.entry.body))}</span>
        <a href={mediumUrl} class="transition-colors duration-200 hover:text-accent print:hidden">
          {t.medium}
        </a>
      </div>
    </header>

    <div class="mt-16 desk:grid desk:grid-cols-[minmax(0,46rem)_15rem] desk:items-start desk:gap-22 wide:grid-cols-[minmax(0,52rem)_17rem]">
      <div class="prose">
        <Content />
      </div>
      {toc.length > 0 && (
        <nav
          aria-label={t.contents}
          class="sticky top-12 hidden print:hidden max-h-[calc(100dvh-6rem)] flex-col gap-1 overflow-y-auto desk:flex"
        >
          <span class="label pb-2.5 text-faint">{t.contents}</span>
          <ul class="flex flex-col">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="group flex items-baseline gap-3 py-1.5 text-sm leading-snug text-muted transition-colors duration-200 hover:text-text"
                >
                  <span class="h-px w-3 flex-none -translate-y-1 bg-line-strong transition-all duration-200 group-hover:w-5 group-hover:bg-accent" />
                  <span>{h.text}</span>
                </a>
                {h.children.length > 0 && (
                  <ul class="mb-1 ml-6 flex flex-col border-l border-line pl-3">
                    {h.children.map((c) => (
                      <li>
                        <a
                          href={`#${c.slug}`}
                          class="block py-1 text-[13px] leading-snug text-faint transition-colors duration-200 hover:text-text"
                        >
                          {c.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
    <div class="mt-24 max-w-180">
      <Continue
        heading={t.keepReading}
        previous={previous && { label: t.previous, link: link(previous) }}
        next={next && { label: t.next, link: link(next) }}
        more={{ label: t.moreOn(t.topics[topic]), links: more.map(link) }}
        follow={{
          label: t.follow,
          links: [
            { href: localize(paths.writingFeed, lang), label: 'RSS' },
            { href: medium.href, label: medium.label },
          ],
        }}
      />
    </div>
  </article>
</Base>
