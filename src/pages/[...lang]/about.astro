---
import type { InferGetStaticPropsType } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tagline from '../../components/Tagline.astro';
import ArrowRight from '../../components/ArrowRight.astro';
import { ui } from '../../i18n/ui';
import { langPaths, localize } from '../../lib/i18n';
import { documentTitle } from '../../lib/format';
import { jsonLd, profile } from '../../lib/structured';
import { links, paths, site } from '../../site';

export const getStaticPaths = langPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = ui[lang].about;
const years = ui[lang].years;
const entry = await getEntry('pages', `about/${lang}`);
if (!entry) throw new Error(`src/content/pages/about/${lang}.md is missing`);
const { Content } = await render(entry);
const structured = jsonLd(
  profile(
    { name: site.name, url: site.url },
    links.map((l) => l.href).filter((href) => href.startsWith('https://')),
  ),
);
---
<Base lang={lang} title={documentTitle(t.heading)} description={t.description}>
  <script type="application/ld+json" set:html={structured} />
  <article class="flex flex-col gap-14 px-6 pt-9 pb-24 desk:px-24 desk:pt-26">
    <header class="flex flex-col gap-7 border-b border-line pb-8">
      <Tagline lang={lang} />
      <h1 class="font-display text-d2 desk:text-d1">{t.heading}</h1>
    </header>

    <div class="prose max-w-170">
      <Content />
    </div>

    <a href={localize(paths.years, lang)} class="group inline-flex w-fit items-center gap-2 text-[15px] text-accent">{years.all}<ArrowRight /></a>
  </article>
</Base>
