---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PhotoPicture from '../../../components/PhotoPicture.astro';
import PhotoPanel from '../../../components/PhotoPanel.astro';
import PhotoRights from '../../../components/PhotoRights.astro';
import TranslatedBadge from '../../../components/TranslatedBadge.astro';
import { ui } from '../../../i18n/ui';
import { langItemPaths, localize } from '../../../lib/i18n';
import { allSeries, coverSources, photoSlug } from '../../../lib/photos';
import { coverFirst, coverTransition, imageObject, largest, mapPath, photoPath, seriesPath, variantPath, FRAME_SIZES, PHOTOGRAPHER } from '../../../lib/photo';
import { absoluteUrl, documentTitle } from '../../../lib/format';
import { jsonLd } from '../../../lib/structured';
import { paths } from '../../../site';

export const getStaticPaths = () => langItemPaths(allSeries, (series) => ({ series: series.id }));

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, item: series } = Astro.props;
const t = ui[lang].photos;
const { title, description, photos } = series;
const shown = coverFirst(photos, series.cover);
const transition = coverTransition(series.id, coverSources(await allSeries(lang)));
const returns = transition && `${localize(paths.photos, lang)} ${localize(paths.home, lang)}`;
const { Content } = await render(series.entry);
const structured = jsonLd({
  '@context': 'https://schema.org',
  '@graph': photos.map((p) => {
    const big = largest(p.data.variants.webp);
    return imageObject({
      url: absoluteUrl(variantPath(big.file)),
      page: absoluteUrl(photoPath(series.id, photoSlug(p), lang)),
      caption: p.alt,
      taken: p.data.taken,
      width: big.width,
      height: big.height,
      notice: (year) => t.copyright(year, PHOTOGRAPHER),
    });
  }),
});
---
<Base lang={lang} title={documentTitle(title, ui[lang].nav.photos)} description={description} langs={series.langs}>
  <div class="flex flex-col gap-14 px-6 pt-9 pb-24 desk:gap-16 desk:px-24 desk:pt-26">
    <header class="flex flex-col gap-5">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <nav aria-label={t.breadcrumb} class="label text-faint">
          <a href={localize(paths.photos, lang)} class="transition-colors duration-200 hover:text-accent">{ui[lang].nav.photos}</a> / {title}
        </nav>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {series.original !== lang && <TranslatedBadge original={series.original} href={seriesPath(series.id, series.original)} />}
          <a href={mapPath(lang, series.id)} class="label flex min-h-11 items-center gap-2.5 text-accent transition-opacity duration-200 hover:opacity-85">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"></path><circle cx="12" cy="10" r="2.2"></circle></svg>
            {t.viewOnMap}
          </a>
        </div>
      </div>
      <h1 class="font-display text-d2 desk:text-d1">{title}</h1>
      <div class="prose max-w-155 text-muted">
        <Content />
      </div>
    </header>

    <ul class="photo-grid">
      {shown.map((photo, i) => (
        <li>
          <a
            href={variantPath(largest(photo.data.variants.webp).file)}
            data-open={photoSlug(photo)}
            data-cover-pair={i === 0 ? returns : undefined}
            data-astro-prefetch="false"
            class="group photo-tile"
          >
            <PhotoPicture photo={photo} sizes={FRAME_SIZES} loading={i < 2 ? 'eager' : 'lazy'} class:list={['block h-auto w-full bg-sleeve', i === 0 && transition]} />
            <span class="photo-tile-hint" aria-hidden="true">{t.details}</span>
          </a>
        </li>
      ))}
    </ul>

    <PhotoRights lang={lang} />
  </div>

  <dialog data-lightbox class="lightbox" aria-label={t.dialog(title)}>
    {shown.map((photo, i) => <PhotoPanel lang={lang} photo={photo} index={i} total={shown.length} series={title} />)}
  </dialog>

  <script type="application/ld+json" set:html={structured} />
  <script>
    import '../../../scripts/lightbox.ts';
    import '../../../scripts/cover-transition.ts';
  </script>
</Base>
