---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PhotoPicture from '../../../components/PhotoPicture.astro';
import PhotoPanel from '../../../components/PhotoPanel.astro';
import PhotoRights from '../../../components/PhotoRights.astro';
import TranslatedBadge from '../../../components/TranslatedBadge.astro';
import { ui } from '../../../i18n/ui';
import { langPaths, localize, type Lang } from '../../../lib/i18n';
import { allSeries, largest, photoSlug, type Series } from '../../../lib/photos';
import { imageObject, jsonLd, seriesPath, variantPath, PHOTOGRAPHER } from '../../../lib/photo';

export async function getStaticPaths() {
  const paths = await Promise.all(
    langPaths().map(async ({ params, props: { lang } }) =>
      (await allSeries(lang)).map((series) => ({ params: { ...params, series: series.id }, props: { lang, series } })),
    ),
  );
  return paths.flat();
}

const { lang, series } = Astro.props as { lang: Lang; series: Series };
const t = ui[lang].photos;
const { title, description, photos } = series;
const { Content } = await render(series.entry);
const page = new URL(seriesPath(series.id, lang), Astro.site).toString();
const structured = jsonLd({
  '@context': 'https://schema.org',
  '@graph': photos.map((p) => {
    const big = largest(p.data.variants.webp);
    return imageObject({
      url: new URL(variantPath(big.file), Astro.site).toString(),
      page: `${page}#${photoSlug(p)}`,
      caption: p.alt,
      taken: p.data.taken,
      width: big.width,
      height: big.height,
      notice: (year) => t.copyright(year, PHOTOGRAPHER),
    });
  }),
});
---
<Base lang={lang} title={t.seriesTitle(title)} description={description} counterpart={series.alternate}>
  <div class="flex flex-col gap-14 px-6 pt-9 pb-24 desk:gap-16 desk:px-24 desk:pt-26">
    <header class="flex flex-col gap-5">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <nav aria-label={t.breadcrumb} class="label text-faint">
          <a href={localize('/photos/', lang)} class="transition-colors duration-200 hover:text-accent">{ui[lang].nav.photos}</a> / {title}
        </nav>
        {series.original !== lang && <TranslatedBadge lang={lang} original={series.original} href={seriesPath(series.id, series.original)} />}
      </div>
      <h1 class="font-display text-d2 desk:text-d1">{title}</h1>
      <div class="prose max-w-155 text-muted">
        <Content />
      </div>
    </header>

    <ul class="photo-grid">
      {photos.map((photo, i) => (
        <li>
          <a
            href={variantPath(largest(photo.data.variants.webp).file)}
            data-open={photoSlug(photo)}
            data-astro-prefetch="false"
            class="group photo-tile"
          >
            <PhotoPicture photo={photo} sizes="(min-width: 64rem) 36vw, (min-width: 40rem) 50vw, 100vw" loading={i < 2 ? 'eager' : 'lazy'} class="block h-auto w-full bg-sleeve" />
            <span class="photo-tile-hint" aria-hidden="true">{t.details}</span>
          </a>
        </li>
      ))}
    </ul>

    <PhotoRights lang={lang} />
  </div>

  <dialog data-lightbox class="lightbox" aria-label={t.dialog(title)}>
    {photos.map((photo, i) => <PhotoPanel lang={lang} photo={photo} index={i} total={photos.length} series={title} />)}
  </dialog>

  <script type="application/ld+json" set:html={structured} />
  <script>
    import '../../../scripts/lightbox.ts';
  </script>
</Base>
