---
import Base from '../../../layouts/Base.astro';
import PhotoPicture from '../../../components/PhotoPicture.astro';
import PhotoRights from '../../../components/PhotoRights.astro';
import ArrowRight from '../../../components/ArrowRight.astro';
import { ui } from '../../../i18n/ui';
import { langPaths, type Lang } from '../../../lib/i18n';
import { allSeries, type Photo } from '../../../lib/photos';
import { seriesPath, takenYear } from '../../../lib/photo';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].photos;
const all = await allSeries(lang);
const years = (photos: Photo[]) => {
  const ys = [...new Set(photos.map((p) => takenYear(p.data.taken)))].sort();
  return ys.length > 1 ? `${ys[0]}–${ys.at(-1)}` : String(ys[0]);
};
---
<Base lang={lang} title={t.title} description={t.description}>
  <div class="flex flex-col gap-16 px-6 pt-9 pb-24 desk:gap-20 desk:px-24 desk:pt-26">
    <header class="flex items-baseline justify-between border-b border-line pb-5">
      <h1 class="font-display text-d2 desk:text-d1">{ui[lang].nav.photos}</h1>
      <span class="label text-faint">{t.series(all.length)}</span>
    </header>

    <ul class="grid gap-x-8 gap-y-14 desk:grid-cols-2">
      {all.map((series, i) => (
        <li>
          <a href={seriesPath(series.id, lang)} class="group flex flex-col gap-5">
            <PhotoPicture photo={series.cover} sizes="(min-width: 64rem) 36vw, 100vw" loading={i < 2 ? 'eager' : 'lazy'} class="aspect-4/5 h-auto w-full bg-sleeve object-cover transition-opacity duration-300 group-hover:opacity-90" />
            <span class="flex flex-col gap-2 border-t border-line pt-4">
              <span class="label text-faint">{t.count(series.photos.length)} · {years(series.photos)}</span>
              <span class="flex items-center justify-between gap-4">
                <span class="font-display text-d3 transition-colors duration-200 group-hover:text-accent">{series.title}</span>
                <span class="text-accent"><ArrowRight size={18} /></span>
              </span>
              <span class="text-[15px] text-muted">{series.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <PhotoRights lang={lang} />
  </div>
</Base>
