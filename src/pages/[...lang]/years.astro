---
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import Odometer from '../../components/Odometer.astro';
import YearBooks from '../../components/YearBooks.astro';
import { home } from '../../site';
import { ui } from '../../i18n/ui';
import { langPaths } from '../../lib/i18n';
import { years } from '../../lib/years';
import { categories, categoryTint } from '../../lib/book';
import { documentTitle, formatNumber, monthInitials, plural } from '../../lib/format';

export const getStaticPaths = langPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = ui[lang];
const n = (value: number) => formatNumber(value, lang);
const { rows, peaks } = await years(lang);
const letters = monthInitials(lang);
const columns = {
  books: t.home.pagesRead,
  frames: t.home.frames,
  farthest: t.home.farthest,
  words: t.home.wordsWritten,
};
const grid =
  'grid grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-x-4 @4xl:grid-cols-[6rem_minmax(0,3fr)_minmax(13rem,2fr)_11.5rem_minmax(7rem,1fr)] @4xl:gap-x-6 @7xl:gap-x-10';
const wide = 'col-span-2 @4xl:col-span-1';
const label = 'label text-xs';
const cellLabel = `${label} text-faint @4xl:sr-only`;
const summary = 'flex items-center font-mono text-[15px] tracking-[0.02em] text-text-body';
const detail = 'text-[15px] leading-normal text-muted';
const peakDot = 'mr-2 inline-block size-1.5 flex-none rounded-full bg-accent';
const none = 'hidden text-[15px] text-muted @4xl:block';
---

<Base lang={lang} title={documentTitle(t.years.heading)}>
  <article class="px-6 pt-9 pb-24 desk:px-16 desk:pt-26">
    <header>
      <p class="font-mono text-sm tracking-[0.04em] text-accent">
        {rows.at(-1)!.year} — {rows[0].year}
      </p>
      <h1 class="mt-3 font-display text-d2 desk:mt-4 desk:text-d1">{t.years.heading}</h1>
      <p class="mt-6 flex flex-wrap gap-x-4.5 gap-y-2 desk:mt-8 desk:gap-x-5.5 desk:gap-y-2.5" aria-hidden="true">
        {categories.map((c) => (
          <span class:list={[detail, 'inline-flex items-center gap-2']}>
            <span class:list={['block h-4.5 w-3 rounded-[1px] border border-line-strong', categoryTint[c]]}></span>
            {t.reading.categories[c]}
          </span>
        ))}
        <span class:list={[detail, 'inline-flex items-center gap-2']}>
          <span class="block h-4.5 w-3 rounded-[1px] border border-dashed border-muted"></span>
          {t.reading.now}
        </span>
      </p>
    </header>

    <div class="mt-8 @container desk:mt-14">
      <div class:list={[grid, 'hidden items-end border-b border-line-strong pb-3 @4xl:grid']} aria-hidden="true">
        <span></span>
        <span>
          <span class:list={[label, 'block text-accent']}>{columns.books}</span>
          <span class="mt-2.5 flex">
            {letters.map((m) => (
              <span class="flex-1 font-mono text-[11px] text-faint">{m}</span>
            ))}
          </span>
        </span>
        <span class:list={[label, 'text-accent']}>{columns.frames}</span>
        <span class:list={[label, 'text-accent']}>{columns.farthest}</span>
        <span class:list={[label, 'text-accent']}>{columns.words}</span>
      </div>
      {rows.map((row) =>
        row.empty ? (
          <section
            id={String(row.year)}
            aria-labelledby={`year-${row.year}`}
            class="border-t border-line py-2 @4xl:border-t-0 @4xl:border-b @4xl:py-2.5"
          >
            <h2 id={`year-${row.year}`} class="font-display text-d4 text-faint">
              {row.year}
            </h2>
          </section>
        ) : (
          <section
            id={String(row.year)}
            aria-labelledby={`year-${row.year}`}
            class:list={[
              grid,
              'items-start gap-y-6 border-t border-line-strong py-7 @4xl:border-t-0 @4xl:border-b @4xl:border-line @4xl:py-8',
            ]}
          >
            <h2
              id={`year-${row.year}`}
              class:list={[wide, 'font-display text-d3 leading-[1.1] @4xl:text-d2 @4xl:leading-none']}
            >
              {row.year}
            </h2>
            <div class={wide}>
              <h3 class={cellLabel}>{columns.books}</h3>
              {row.books.count > 0 && (
                <p class:list={[summary, 'mt-1.5 @4xl:mt-0']}>
                  {peaks.books === row.year && <span class={peakDot} aria-hidden="true"></span>}
                  {plural(t.reading.result, row.books.count)} · {t.reading.pageCount(n(row.books.pages))}
                </p>
              )}
              <div class="mt-2.5 @4xl:mt-3">
                <YearBooks
                  months={row.books.months}
                  reading={row.books.reading}
                  lastMonth={row.books.lastMonth}
                  letters={letters}
                />
              </div>
            </div>
            {row.frames.count > 0 ? (
              <div class={wide}>
                <h3 class={cellLabel}>{columns.frames}</h3>
                <p class:list={[summary, 'mt-1.5 @4xl:mt-0']}>
                  {peaks.frames === row.year && <span class={peakDot} aria-hidden="true"></span>}
                  {plural(t.years.frames, row.frames.count)}
                  {row.frames.countries > 0 &&
                    ` · ${n(row.frames.countries)} ${plural(t.home.countries, row.frames.countries)}`}
                </p>
                <span class="mt-2.5 flex flex-wrap gap-0.5 @4xl:mt-3" aria-hidden="true">
                  {Array.from({ length: row.frames.count }, () => (
                    <span class="block h-2.5 w-1.5 rounded-[1px] bg-faint"></span>
                  ))}
                </span>
                {row.frames.cities.length > 0 && (
                  <p class:list={[detail, 'mt-2 @4xl:mt-2.5']}>{row.frames.cities.map(t.years.city).join(' · ')}</p>
                )}
              </div>
            ) : (
              <p class={none} aria-hidden="true">
                —
              </p>
            )}
            {row.farthest ? (
              <div>
                <h3 class={cellLabel}>{columns.farthest}</h3>
                <span class="mt-2 flex items-end gap-1.5 @4xl:mt-0">
                  <span class="sr-only">
                    {n(row.farthest.km)} {t.home.km}
                  </span>
                  <Odometer shown={n(row.farthest.km)} size="mini" />
                  <span class:list={[label, 'hidden pb-1 text-faint @4xl:inline']} aria-hidden="true">
                    {t.home.km}
                  </span>
                  {peaks.farthest === row.year && (
                    <span
                      class="mb-3 ml-0.5 inline-block size-1.5 flex-none rounded-full bg-accent"
                      aria-hidden="true"
                    ></span>
                  )}
                </span>
                <p class:list={[detail, 'mt-1.5 @4xl:mt-2']}>
                  {t.years.route(home.city, t.years.city(row.farthest.city))}
                  <span class="@4xl:hidden" aria-hidden="true">
                    {' '}
                    · {t.home.km}
                  </span>
                </p>
              </div>
            ) : (
              <p class={none} aria-hidden="true">
                —
              </p>
            )}
            {row.writing.count > 0 ? (
              <div class="col-start-2 @4xl:col-start-auto">
                <h3 class={cellLabel}>{columns.words}</h3>
                <p class:list={[summary, 'mt-2 @4xl:mt-0']}>
                  {peaks.words === row.year && <span class={peakDot} aria-hidden="true"></span>}
                  {n(row.writing.words)}
                </p>
                <span class="mt-3 flex flex-wrap gap-1" aria-hidden="true">
                  {Array.from({ length: row.writing.count }, () => (
                    <span class="block size-4.5 rounded-[2px] border border-line-strong bg-sleeve"></span>
                  ))}
                </span>
                <p class:list={[detail, 'mt-1.5 @4xl:mt-2.5']}>{t.writing.published(row.writing.count)}</p>
              </div>
            ) : (
              <p class={none} aria-hidden="true">
                —
              </p>
            )}
          </section>
        ),
      )}
    </div>
  </article>
</Base>
