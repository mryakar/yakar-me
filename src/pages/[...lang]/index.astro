---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import Tagline from '../../components/Tagline.astro';
import ArrowRight from '../../components/ArrowRight.astro';
import PhotoPicture from '../../components/PhotoPicture.astro';
import LatestCard from '../../components/LatestCard.astro';
import BookShelf from '../../components/BookShelf.astro';
import { site, nowUpdated } from '../../site';
import { ui } from '../../i18n/ui';
import { langPaths, localize, type Lang } from '../../lib/i18n';
import { lastTaken, recentSeries, type Photo } from '../../lib/photos';
import { seriesPath } from '../../lib/photo';
import { articles } from '../../lib/writing';
import { books } from '../../lib/books';
import { articlePath, documentTitle, formatDate, formatMonth } from '../../lib/format';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const all = await articles(lang);
const latest = all[0];
const recent = await recentSeries(lang, 3);
const newest = recent[0];
const columns = ['', 'desk:grid-cols-1', 'desk:grid-cols-2', 'desk:grid-cols-3'][recent.length];
const seriesMonth = (photos: Photo[]) => formatMonth(new Date(lastTaken(photos).slice(0, 10)), lang);
const [heroStart, heroEm, heroEnd] = t.home.hero;
const { reading, finished } = await books(lang);
const now = [...(reading.length > 0 ? [{ label: t.home.nowReading, books: reading }] : []), ...t.now];
---
<Base lang={lang} title={documentTitle()}>
  <div class="flex flex-col gap-28 px-6 pt-9 pb-16 desk:gap-34 desk:px-24 desk:pt-26">
    <section class="grid gap-14 desk:grid-cols-[minmax(0,1fr)_20rem] desk:items-end desk:gap-20">
      <div class="flex flex-col gap-8">
        <Tagline lang={lang} />
        <h1 class="font-display text-d2 desk:text-d1">{heroStart}<em class="text-accent">{heroEm}</em>{heroEnd}</h1>
        <p class="max-w-140 text-lede text-muted">{t.lede}</p>
      </div>
      <div class="flex flex-col gap-9">
        {latest && (
          <LatestCard href={articlePath(latest.id, lang)} label={`${t.home.latestWriting} · ${formatDate(latest.pubDate, 'short', lang)}`} title={latest.title} action={t.home.read} />
        )}
        {newest && (
          <LatestCard href={seriesPath(newest.id, lang)} label={`${t.home.latestSeries} · ${seriesMonth(newest.photos)}`} title={newest.title} action={t.home.view} />
        )}
      </div>
    </section>

    {recent.length > 0 && (
      <section class="reveal grid gap-10 desk:grid-cols-[13rem_minmax(0,1fr)] desk:gap-16" aria-labelledby="photos">
        <div class="flex flex-col gap-5 border-t border-line-strong pt-5.5">
          <h2 id="photos" class="font-display text-d3">{t.nav.photos}</h2>
          <p class="text-[15px] leading-relaxed text-muted">{t.home.photosIntro}</p>
          <a href={localize('/photos/', lang)} class="inline-flex items-center gap-2 text-[15px] text-accent">
            {t.home.allSeries}
            <ArrowRight />
          </a>
        </div>
        <ul class:list={['grid grid-cols-2 gap-x-4 gap-y-10 desk:gap-x-6', columns]}>
          {recent.map((series, i) => (
            <li class:list={[i > 1 && 'hidden desk:block']}>
              <a href={seriesPath(series.id, lang)} class="group flex flex-col gap-4">
                <PhotoPicture photo={series.cover} sizes="(min-width: 64rem) 30vw, 45vw" class="aspect-4/5 h-auto w-full bg-sleeve object-cover transition-opacity duration-300 group-hover:opacity-90" />
                <span class="flex flex-col gap-1.5">
                  <span class="label text-faint">{seriesMonth(series.photos)} · {t.photos.count(series.photos.length)}</span>
                  <span class="font-body text-xl leading-tight text-text transition-colors duration-200 group-hover:text-accent">{series.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="reveal flex flex-col gap-10" aria-labelledby="writing">
      <div class="flex items-baseline justify-between border-b border-line pb-5">
        <h2 id="writing" class="font-display text-d3">{t.nav.writing}</h2>
        <a href={localize('/writing/', lang)} class="label text-faint transition-colors duration-200 hover:text-accent">{t.home.publishedAll(all.length)}</a>
      </div>
      <Shelf articles={all} lang={lang} />
    </section>

    <section class="reveal flex flex-col gap-10" aria-labelledby="reading">
      <div class="flex items-baseline justify-between border-b border-line pb-5">
        <h2 id="reading" class="font-display text-d3">{t.nav.reading}</h2>
        <a href={localize('/reading/', lang)} class="label text-faint transition-colors duration-200 hover:text-accent">{t.home.booksAll(finished.length)}</a>
      </div>
      <BookShelf reading={reading} finished={finished} lang={lang} />
    </section>

    <section class="reveal flex flex-col gap-8" aria-labelledby="now">
      <div class="flex items-baseline justify-between">
        <h2 id="now" class="font-display text-d3">{t.home.now}</h2>
        <span class="label text-faint">{t.home.updated(formatMonth(nowUpdated, lang))}</span>
      </div>
      <div class="grid gap-10 desk:grid-cols-3">
        {now.map((item) => (
          <div class="flex flex-col gap-2.5 border-t border-line pt-5">
            <span class="label text-faint">{item.label}</span>
            <p class="font-body text-[1.375rem] leading-snug text-text">
              {'books' in item
                ? item.books.map((book, i) => (
                    <>{i > 0 && ` ${t.home.also} `}<em>{book.title}</em>{book.edition && `, ${t.reading.editionValue(book.edition)}`}.{book.nowNote && ` ${book.nowNote}`}</>
                  ))
                : item.text}
            </p>
          </div>
        ))}
      </div>
    </section>

    <footer class="flex items-center justify-between border-t border-line pt-6">
      <span class="label text-faint">© {new Date().getUTCFullYear()} {site.name}</span>
      <a href={localize('/rss.xml', lang)} class="label text-faint transition-colors duration-200 hover:text-accent">RSS</a>
    </footer>
  </div>
</Base>
