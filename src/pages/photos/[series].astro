---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoPicture from '../../components/PhotoPicture.astro';
import PhotoPanel from '../../components/PhotoPanel.astro';
import PhotoRights from '../../components/PhotoRights.astro';
import { allSeries, largest, photoSlug, type Photo, type Series } from '../../lib/photos';
import { imageObject, jsonLd, seriesPath, variantPath } from '../../lib/photo';

export async function getStaticPaths() {
  return (await allSeries()).map(({ series, photos }) => ({ params: { series: series.id }, props: { series, photos } }));
}

const { series, photos } = Astro.props as { series: Series; photos: Photo[] };
const { title, description } = series.data;
const { Content } = await render(series);
const page = new URL(seriesPath(series.id), Astro.site).toString();
const structured = jsonLd({
  '@context': 'https://schema.org',
  '@graph': photos.map((p) => {
    const big = largest(p.data.variants.webp);
    return imageObject({
      url: new URL(variantPath(big.file), Astro.site).toString(),
      page: `${page}#${photoSlug(p)}`,
      caption: p.data.alt,
      taken: p.data.taken,
      width: big.width,
      height: big.height,
    });
  }),
});
---
<Base title={`${title} — Photos — yakar.me`} description={description}>
  <div class="flex flex-col gap-14 px-6 pt-9 pb-24 desk:gap-16 desk:px-24 desk:pt-26">
    <header class="flex flex-col gap-5">
      <nav aria-label="Breadcrumb" class="label text-faint">
        <a href="/photos/" class="transition-colors duration-200 hover:text-accent">Photos</a> / {title}
      </nav>
      <h1 class="font-display text-d2 desk:text-d1">{title}</h1>
      <div class="prose max-w-155 text-muted">
        <Content />
      </div>
    </header>

    <ul class="photo-grid">
      {photos.map((photo, i) => (
        <li>
          <a
            href={variantPath(largest(photo.data.variants.webp).file)}
            data-open={photoSlug(photo)}
            data-astro-prefetch="false"
            class="group photo-tile"
          >
            <PhotoPicture photo={photo} sizes="(min-width: 64rem) 36vw, (min-width: 40rem) 50vw, 100vw" loading={i < 2 ? 'eager' : 'lazy'} class="block h-auto w-full bg-sleeve" />
            <span class="photo-tile-hint" aria-hidden="true">Details ↗</span>
          </a>
        </li>
      ))}
    </ul>

    <PhotoRights />
  </div>

  <dialog data-lightbox class="lightbox" aria-label={`${title} — photo details`}>
    {photos.map((photo, i) => <PhotoPanel photo={photo} index={i} total={photos.length} series={title} />)}
  </dialog>

  <script type="application/ld+json" set:html={structured} />
  <script>
    import '../../scripts/lightbox.ts';
  </script>
</Base>
