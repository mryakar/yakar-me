---
import Base from '../layouts/Base.astro';
import Shelf from '../components/Shelf.astro';
import Tagline from '../components/Tagline.astro';
import ArrowRight from '../components/ArrowRight.astro';
import PhotoPicture from '../components/PhotoPicture.astro';
import LatestCard from '../components/LatestCard.astro';
import { site, now } from '../site';
import { lastTaken, recentSeries, type Photo } from '../lib/photos';
import { seriesPath } from '../lib/photo';
import { articles } from '../lib/writing';
import { articlePath, formatDate, formatMonth } from '../lib/format';

const all = await articles();
const latest = all[0];
const updated = formatMonth(now.updated);
const recent = await recentSeries(3);
const newest = recent[0];
const columns = ['', 'desk:grid-cols-1', 'desk:grid-cols-2', 'desk:grid-cols-3'][recent.length];
const seriesMonth = (photos: Photo[]) => formatMonth(new Date(lastTaken(photos).slice(0, 10)));
---
<Base title={site.domain}>
  <div class="flex flex-col gap-28 px-6 pt-9 pb-16 desk:gap-34 desk:px-24 desk:pt-26">
    <section class="grid gap-14 desk:grid-cols-[minmax(0,1fr)_20rem] desk:items-end desk:gap-20">
      <div class="flex flex-col gap-8">
        <Tagline />
        <h1 class="font-display text-d2 desk:text-d1">Code, a saxophone, and a habit of taking the long way <em class="text-accent">round</em>.</h1>
        <p class="max-w-140 text-lede text-muted">{site.lede}</p>
      </div>
      <div class="flex flex-col gap-9">
        <LatestCard href={articlePath(latest.id)} label={`Latest writing · ${formatDate(latest.data.pubDate, 'short')}`} title={latest.data.title} action="Read" />
        {newest && (
          <LatestCard href={seriesPath(newest.series.id)} label={`Latest series · ${seriesMonth(newest.photos)}`} title={newest.series.data.title} action="View" />
        )}
      </div>
    </section>

    {recent.length > 0 && (
      <section class="reveal grid gap-10 desk:grid-cols-[13rem_minmax(0,1fr)] desk:gap-16" aria-labelledby="photos">
        <div class="flex flex-col gap-5 border-t border-line-strong pt-5.5">
          <h2 id="photos" class="font-display text-d3">Photos</h2>
          <p class="text-[15px] leading-relaxed text-muted">Series from the road, mostly after dark, on whichever camera was closest.</p>
          <a href="/photos/" class="inline-flex items-center gap-2 text-[15px] text-accent">
            All series
            <ArrowRight />
          </a>
        </div>
        <ul class:list={['grid grid-cols-2 gap-x-4 gap-y-10 desk:gap-x-6', columns]}>
          {recent.map(({ series, photos, cover }, i) => (
            <li class:list={[i > 1 && 'hidden desk:block']}>
              <a href={seriesPath(series.id)} class="group flex flex-col gap-4">
                <PhotoPicture photo={cover} sizes="(min-width: 64rem) 30vw, 45vw" class="aspect-4/5 h-auto w-full bg-sleeve object-cover transition-opacity duration-300 group-hover:opacity-90" />
                <span class="flex flex-col gap-1.5">
                  <span class="label text-faint">{seriesMonth(photos)} · {photos.length} photos</span>
                  <span class="font-body text-xl leading-tight text-text transition-colors duration-200 group-hover:text-accent">{series.data.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="reveal flex flex-col gap-10" aria-labelledby="writing">
      <div class="flex items-baseline justify-between border-b border-line pb-5">
        <h2 id="writing" class="font-display text-d3">Writing</h2>
        <a href="/writing/" class="label text-faint transition-colors duration-200 hover:text-accent">{all.length} published · all</a>
      </div>
      <Shelf articles={all} />
    </section>

    <section class="reveal flex flex-col gap-8" aria-labelledby="now">
      <div class="flex items-baseline justify-between">
        <h2 id="now" class="font-display text-d3">Now</h2>
        <span class="label text-faint">Updated {updated}</span>
      </div>
      <div class="grid gap-10 desk:grid-cols-3">
        {now.items.map((item) => (
          <div class="flex flex-col gap-2.5 border-t border-line pt-5">
            <span class="label text-faint">{item.label}</span>
            <p class="font-body text-[1.375rem] leading-snug text-text">
              {item.title && <em>{item.title}</em>}{item.rest}
            </p>
          </div>
        ))}
      </div>
    </section>

    <footer class="flex items-center justify-between border-t border-line pt-6">
      <span class="label text-faint">© {new Date().getUTCFullYear()} {site.name}</span>
      <a href="/rss.xml" class="label text-faint transition-colors duration-200 hover:text-accent">RSS</a>
    </footer>
  </div>
</Base>
